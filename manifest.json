{
  "manifest_version": 3,
  "name": "Karotter UI Fix",
  "version": "1.1",
  "description": "Karotterのタイムラインの幅やUIを調整する拡張機能です。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Karotter UI Fix 設定"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://karotter.jp/*",
        "https://api.karotter.jp/*",
        "https://karotter.com/*",
        "https://api.karotter.com/*",
        "https://karotter.karon.jp/*",
        "https://apikarotter.karon.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
